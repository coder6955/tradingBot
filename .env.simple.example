# Essential settings only.
# Daily use: open /dashboard, choose Paper orders or Live orders, then Start Full Automation.

DATABASE_URL=mysql+pymysql://user:password@localhost:3306/option_trading
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

ORDER_MODE=paper
ENABLE_AUTO_SQUAREOFF=true
LIVE_AUTO_SQUAREOFF=false
OPTION_TIME_STOP_MINUTES=15
OPTION_TIME_STOP_MIN_MOVE_PCT=6.0
OPTION_TRAILING_STOP_LOCK_PCT=2.0
EXIT_OPEN_TRADES_BEFORE_CLOSE_MINUTES=10
FAST_EXIT_INTERVAL_SECONDS=2
ENABLE_KITE_WEBSOCKET=false
WEBSOCKET_PRICE_STALE_SECONDS=3
WEBSOCKET_RECONNECT_ENABLED=true
WEBSOCKET_LIVE_STALE_BLOCKS=true
WEBSOCKET_LIVE_REQUIRE_EXCHANGE_TIMESTAMP=true
ENABLE_WEBSOCKET_PREMIUM_CANDLE_BUILDER=true
WEBSOCKET_PREMIUM_CANDLE_TIMEFRAME=1minute
WEBSOCKET_PREMIUM_CANDLE_RETENTION_MINUTES=60
LIVE_EXIT_MAX_RETRY_COUNT=2
LIVE_RECONCILIATION_BLOCKS_AUTOMATION=true
OPTION_QUOTE_PREMIUM_MISMATCH_TOLERANCE_PCT=25.0
MAX_TREND_MOMENTUM_SCORE=75
ENABLE_BANKNIFTY_INTELLIGENCE=true
ENABLE_UNDERLYING_INVALIDATION_EXIT=true
ENABLE_PREMIUM_INVALIDATION_EXIT=true
ENABLE_PARTIAL_BOOKING=false
MAX_LIVE_QUOTE_AGE_SECONDS=8
MAX_LIVE_OPTION_QUOTE_AGE_SECONDS=8
MAX_LIVE_CHAIN_AGE_SECONDS=10
MAX_LIVE_CANDLE_AGE_SECONDS=420
MAX_PREMIUM_CONFIRMATION_CANDLE_AGE_SECONDS=900
BANKNIFTY_EVENT_DATES=
BACKTEST_CHARGES_PCT=0.20

AUTOMATION_ENABLED=false
AUTOMATION_SYMBOLS=BANKNIFTY
AUTOMATION_SIDE=BUY

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
